{
  "demo": false,
  "timezone": "UTC",
  "connectorTimeoutMs": 30000,
  "perConnectorCharBudget": 4000,
  "connectors": [
    {
      "id": "github",
      "enabled": true,
      "config": {
        "maxItems": 15,
        "includeNotifications": true,
        "includeAssigned": true,
        "includeReviewRequests": true
      }
    },
    {
      "id": "calendar",
      "enabled": true,
      "config": {
        "maxEvents": 20
      }
    }
  ],
  "llm": {
    "provider": "openai-compatible",
    "model": "gpt-4.1-mini"
  },
  "delivery": {
    "channel": "file"
  },
  "scheduleHint": "0 7 * * *"
}
