# RoosterAI env — secrets only. Preferences live in rooster.config.json.
# Copy to .env and fill tiers as you go. The dashboard never writes these.

# ── Tier 0 — no keys ──────────────────────────────────────────────
# Prove the install works with canned data (no .env required):
#   npm run wake -- --demo
# Then: npm run dev  → open the dashboard (first run lands on /coop).

# ── Tier 1 — morning sources + one LLM key ────────────────────────
# GitHub + Calendar lead: every visitor already has a GitHub account,
# and any calendar (Google / Apple / Outlook) exposes a secret ICS URL.
# Stock them in /coop (or copy rooster.config.example.json).
# IMAP stays available; GA4 is advanced (bottom of this file).

# Classic PAT: needs `notifications` scope (+ `repo` for private search).
# Fine-grained tokens work for assigned/review search, but GET /notifications
# still requires a classic PAT — see GitHub docs.
GITHUB_TOKEN=

# Secret ICS URL from Google Calendar / Apple / Outlook (no API key).
# Setup walkthrough: README.md → Connector setup guides → Calendar.
CALENDAR_ICS_URL=

# Optional: IMAP (Gmail app password ~2 min). Enable via /coop.
# Gmail: enable 2FA, create an App Password, use imap.gmail.com:993.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASS=

# OpenAI-compatible (OpenAI, Groq, OpenRouter, Ollama, LM Studio)
# For Ollama/LM Studio, point OPENAI_BASE_URL at the local server.
# Default model: gpt-5.6-terra
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (https://aistudio.google.com/apikey)
# Default model: gemini-3.5-flash
GEMINI_API_KEY=

# ── Tier 2 — delivery ─────────────────────────────────────────────
# Telegram Web walkthrough: README.md → Connector setup guides → Telegram.
# BotFather token + your numeric chat id (@userinfobot). Then set delivery
# to "telegram" in Settings (or rooster.config.json).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Tier 3 — everything else ──────────────────────────────────────
# Anthropic (optional alternative to OpenAI-compatible)
# Default model: claude-sonnet-4.5
ANTHROPIC_API_KEY=

# HTTP trigger for POST /api/run — route refuses to run if unset
# Generate something long and random: openssl rand -hex 32
# Not used by GitHub Actions (`npm run wake`) — only by POST /api/run
ROOSTER_RUN_TOKEN=

# ── Advanced / optional — GA4 service-account auth ─────────────────
# Needs a GCP project, service account JSON key, and Viewer on properties.
# Enable BOTH APIs on the GCP project that owns the key:
#   - Google Analytics Data API   (reports)
#   - Google Analytics Admin API  (property picker list)
# Put the JSON path here, then pick sites in /setup or /settings.
# GA4_PROPERTY_ID is optional fallback (comma-separated) if you skip the picker.
# GA4_PROPERTY_ID=123456789,987654321
GOOGLE_APPLICATION_CREDENTIALS=./ga4-service-account.json
